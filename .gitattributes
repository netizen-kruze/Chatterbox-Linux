*.py      text eol=lf
*.desktop text eol=lf
*.svg     text eol=lf
*.cs      text
*.md      text
*.json    text
*.html    text
*.js      text
*.css     text
*.csproj  text
*.sln     text
*.png     binary
*.ico     binary
*.wav     binary
*.woff2   binary
